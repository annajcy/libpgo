{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PGO_USE_MKL": "ON",
                "PGO_ENABLE_FULL": "ON",
                "PGO_BUILD_SUBPROJECTS": "ON",
                "PGO_ENABLE_PYTHON": "ON",
                "PGO_ENABLE_ALEMBIC": "ON",
                "PGO_ENABLE_GMSH": "ON",
                "PGO_TET_MESHER_USE_TET_WILD": "ON",
                "PGO_ENABLE_OPENVDB": "ON",
                "PGO_BUILD_TESTING": "ON",
                "PGO_BUILD_BENCHMARKS": "ON",
                "PGO_PORTABLE_BUILD": "OFF",
                "PGO_ENABLE_RELEASE_DEBUG_INFO": "ON",
                "PGO_RUNTIME_LAYOUT": "SOURCE"
            }
        },
        {
            "name": "base-ci",
            "hidden": false,
            "inherits": [
                "base"
            ],
            "binaryDir": "${sourceDir}/build/base-ci",
            "cacheVariables": {
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
                "PGO_NATIVE_OPTIMIZATION": "OFF",
                "Python_FIND_VIRTUALENV": "FIRST"
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "relwithdebinfo",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "pypgo",
            "hidden": false,
            "inherits": [
                "base"
            ],
            "binaryDir": "${sourceDir}/build/pypgo",
            "cacheVariables": {
                "PGO_BUILD_TESTING": "OFF",
                "PGO_BUILD_BENCHMARKS": "OFF",
                "PGO_BUILD_SUBPROJECTS": "OFF",
                "PGO_RUNTIME_LAYOUT": "SOURCE"
            }
        },
        {
            "name": "pypgo-wheel",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/pypgo-wheel",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PGO_USE_MKL": "ON",
                "PGO_ENABLE_FULL": "ON",
                "PGO_BUILD_SUBPROJECTS": "OFF",
                "PGO_ENABLE_PYTHON": "ON",
                "PGO_ENABLE_ALEMBIC": "ON",
                "PGO_ENABLE_GMSH": "ON",
                "PGO_TET_MESHER_USE_TET_WILD": "ON",
                "PGO_ENABLE_OPENVDB": "ON",
                "PGO_BUILD_TESTING": "OFF",
                "PGO_BUILD_BENCHMARKS": "OFF",
                "PGO_ENABLE_CUDA": "OFF",
                "PGO_HAS_ORIG_PARDISO": "OFF",
                "PGO_PORTABLE_BUILD": "ON",
                "PGO_ENABLE_RELEASE_DEBUG_INFO": "OFF",
                "PGO_RUNTIME_LAYOUT": "WHEEL",
                "CMAKE_FIND_USE_PACKAGE_REGISTRY": "OFF",
                "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": "OFF"
            }
        },
        {
            "name": "knitro",
            "hidden": true,
            "cacheVariables": {
                "PGO_OPT_USE_KNITRO": "ON"
            }
        },
        {
            "name": "pardiso",
            "hidden": true,
            "cacheVariables": {
                "PGO_HAS_ORIG_PARDISO": "ON"
            }
        },
        {
            "name": "cuda",
            "hidden": true,
            "cacheVariables": {
                "PGO_ENABLE_CUDA": "ON"
            }
        },
        {
            "name": "base_debug",
            "binaryDir": "${sourceDir}/build/base_debug",
            "inherits": [
                "base",
                "debug"
            ]
        },
        {
            "name": "base_relwithdebinfo",
            "binaryDir": "${sourceDir}/build/base_relwithdebinfo",
            "inherits": [
                "base",
                "relwithdebinfo"
            ]
        },
        {
            "name": "base_knitro",
            "binaryDir": "${sourceDir}/build/base_knitro",
            "inherits": [
                "base",
                "knitro"
            ]
        },
        {
            "name": "base_knitro_cuda",
            "binaryDir": "${sourceDir}/build/base_knitro_cuda",
            "inherits": [
                "base",
                "knitro",
                "cuda"
            ]
        },
        {
            "name": "all_debug",
            "binaryDir": "${sourceDir}/build/all_debug",
            "inherits": [
                "base",
                "knitro",
                "pardiso",
                "cuda",
                "debug"
            ]
        },
        {
            "name": "all_relwithdebinfo",
            "binaryDir": "${sourceDir}/build/all_relwithdebinfo",
            "inherits": [
                "base",
                "knitro",
                "pardiso",
                "cuda",
                "relwithdebinfo"
            ]
        },
        {
            "name": "all",
            "binaryDir": "${sourceDir}/build/all",
            "inherits": [
                "base",
                "knitro",
                "pardiso",
                "cuda"
            ]
        },
        {
            "name": "base_cuda_debug",
            "binaryDir": "${sourceDir}/build/base_cuda_debug",
            "inherits": [
                "base",
                "cuda",
                "debug"
            ]
        },
        {
            "name": "base_cuda_relwithdebinfo",
            "binaryDir": "${sourceDir}/build/base_cuda_relwithdebinfo",
            "inherits": [
                "base",
                "cuda",
                "relwithdebinfo"
            ]
        },
        {
            "name": "base_cuda",
            "binaryDir": "${sourceDir}/build/base_cuda",
            "inherits": [
                "base",
                "cuda"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "base",
            "configurePreset": "base"
        },
        {
            "name": "base-ci",
            "configurePreset": "base-ci"
        },
        {
            "name": "pypgo",
            "configurePreset": "pypgo",
            "targets": [
                "pypgo_core"
            ]
        },
        {
            "name": "pypgo-wheel",
            "configurePreset": "pypgo-wheel",
            "targets": [
                "pypgo_core"
            ]
        },
        {
            "name": "base_debug",
            "configurePreset": "base_debug"
        },
        {
            "name": "base_relwithdebinfo",
            "configurePreset": "base_relwithdebinfo"
        },
        {
            "name": "base_knitro",
            "configurePreset": "base_knitro"
        },
        {
            "name": "base_knitro_cuda",
            "configurePreset": "base_knitro_cuda"
        },
        {
            "name": "all",
            "configurePreset": "all"
        },
        {
            "name": "all_debug",
            "configurePreset": "all_debug"
        },
        {
            "name": "all_relwithdebinfo",
            "configurePreset": "all_relwithdebinfo"
        },
        {
            "name": "base_cuda",
            "configurePreset": "base_cuda"
        },
        {
            "name": "base_cuda_debug",
            "configurePreset": "base_cuda_debug"
        },
        {
            "name": "base_cuda_relwithdebinfo",
            "configurePreset": "base_cuda_relwithdebinfo"
        }
    ]
}
